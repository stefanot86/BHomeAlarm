<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principale dell'applicazione BHomeAlarm.
    Contenitore verticale: in alto il NavHostFragment (area dei contenuti), in basso
    la BottomNavigationView. I due elementi non si sovrappongono (niente margini fissi):
    gli spazi delle system bar (status bar / barra di navigazione) sono gestiti in
    MainActivity tramite i window insets, necessario per l'edge-to-edge di Android 15
    (targetSdk 35), altrimenti i contenuti risulterebbero tagliati sotto le barre.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Contenitore per i fragment di navigazione -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- Barra di navigazione inferiore -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del widget home screen per attivare/disattivare l'allarme.
    Usa solo viste compatibili con RemoteViews (LinearLayout, TextView, ImageView).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Titolo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Stato corrente -->
    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/status_unknown"
        android:textColor="@color/widget_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Ora ultimo aggiornamento -->
    <TextView
        android:id="@+id/widget_status_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <!-- Bottoni Attiva / Disattiva -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Attiva -->
        <LinearLayout
            android:id="@+id/widget_btn_arm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_arm_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/arm_icon"
                android:src="@drawable/ic_lock"
                android:tint="@color/md_theme_light_onPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_arm"
                android:textColor="@color/md_theme_light_onPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spazio tra i bottoni -->
        <View
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <!-- Disattiva -->
        <LinearLayout
            android:id="@+id/widget_btn_disarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_disarm_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/disarm_icon"
                android:src="@drawable/ic_lock_open"
                android:tint="@color/md_theme_light_onError" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_disarm"
                android:textColor="@color/md_theme_light_onError"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
